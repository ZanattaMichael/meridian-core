{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ZanattaMichael/meridian-core/schemas/output/module-install.schema.json",
  "title": "module install, module update",
  "description": "What changed in the lock.",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "description": "The subcommand as it is typed"
    },
    "ok": {
      "type": "boolean",
      "description": "Whether the command did what was asked: false means it exited 1, or 130 when interrupted"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": "string"
          },
          "resolved": {
            "type": [
              "string",
              "null"
            ]
          },
          "integrity": {
            "type": [
              "string",
              "null"
            ]
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "change": {
            "type": "string",
            "enum": [
              "added",
              "updated",
              "removed",
              "unchanged"
            ]
          },
          "from": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "source",
          "resolved",
          "integrity",
          "requires",
          "change",
          "from"
        ]
      }
    },
    "wroteLock": {
      "type": "boolean"
    },
    "lockFile": {
      "type": "string"
    }
  },
  "required": [
    "command",
    "ok",
    "changes",
    "wroteLock",
    "lockFile"
  ],
  "additionalProperties": false
}
