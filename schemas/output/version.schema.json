{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ZanattaMichael/meridian-core/schemas/output/version.schema.json",
  "title": "version",
  "description": "Every version stream of the build.",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "const": "version",
      "description": "The subcommand as it is typed"
    },
    "ok": {
      "type": "boolean",
      "description": "Whether the command did what was asked: false means it exited 1, or 130 when interrupted"
    },
    "meridian": {
      "type": "string"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "supported",
              "deprecated",
              "removed"
            ]
          },
          "release": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "release"
        ]
      }
    },
    "pluginSdk": {
      "type": "string"
    },
    "pluginProtocol": {
      "type": "string"
    },
    "lockfileFormat": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "command",
    "ok",
    "meridian",
    "languages",
    "pluginSdk",
    "pluginProtocol",
    "lockfileFormat"
  ],
  "additionalProperties": false
}
