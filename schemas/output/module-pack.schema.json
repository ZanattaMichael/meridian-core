{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ZanattaMichael/meridian-core/schemas/output/module-pack.schema.json",
  "title": "module pack",
  "description": "The archive written.",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "const": "module pack",
      "description": "The subcommand as it is typed"
    },
    "ok": {
      "type": "boolean",
      "description": "Whether the command did what was asked: false means it exited 1, or 130 when interrupted"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "file": {
      "type": "string"
    },
    "size": {
      "type": "integer",
      "minimum": 0
    },
    "integrity": {
      "type": "string"
    },
    "mediaType": {
      "type": "string"
    }
  },
  "required": [
    "command",
    "ok",
    "name",
    "version",
    "file",
    "size",
    "integrity",
    "mediaType"
  ],
  "additionalProperties": false
}
