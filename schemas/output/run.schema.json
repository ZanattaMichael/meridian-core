{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ZanattaMichael/meridian-core/schemas/output/run.schema.json",
  "title": "A run: compile, plan, apply, drift or rollback",
  "description": "What one of the commands that run a workflow prints with --output json.",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "description": "The subcommand as it is typed"
    },
    "ok": {
      "type": "boolean",
      "description": "Whether the command did what was asked: false means it exited 1, or 130 when interrupted"
    },
    "mode": {
      "type": "string",
      "enum": [
        "compile",
        "plan",
        "apply",
        "drift",
        "rollback"
      ]
    },
    "run": {
      "type": "string",
      "description": "The run's id, under which plan, apply, drift and rollback keep their record; compile has one too but records nothing"
    },
    "refused": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "locked",
                "state",
                "resume",
                "rollback"
              ]
            },
            "message": {
              "type": "string"
            },
            "lock": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/lock"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "message",
            "lock"
          ]
        }
      ]
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stage"
      }
    },
    "rollbacks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rollback"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "stages": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "changes": {
          "type": "integer",
          "minimum": 0
        },
        "hasChanges": {
          "type": "boolean",
          "description": "plan: whether an apply would do something, which is what --detailed-exitcode exits 2 on"
        },
        "drifted": {
          "type": "integer",
          "minimum": 0
        },
        "succeeded": {
          "type": "boolean"
        },
        "interrupted": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "stages",
        "failed",
        "changes",
        "hasChanges",
        "drifted",
        "succeeded",
        "interrupted"
      ]
    }
  },
  "required": [
    "command",
    "ok",
    "mode",
    "run",
    "refused",
    "stages",
    "rollbacks",
    "warnings",
    "summary"
  ],
  "additionalProperties": false,
  "$defs": {
    "stageId": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "Infrastructure",
            "ResourceSet"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "kind"
      ]
    },
    "change": {
      "type": "object",
      "properties": {
        "resource": {
          "type": "string"
        },
        "action": {
          "type": "string",
          "enum": [
            "create",
            "update",
            "delete",
            "replace"
          ]
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "resource",
        "action",
        "summary"
      ]
    },
    "output": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "description": "The output's value, or the mask (sensitive) when it is sensitive"
        },
        "sensitive": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "sensitive"
      ]
    },
    "lock": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "user": {
          "type": [
            "string",
            "null"
          ]
        },
        "host": {
          "type": [
            "string",
            "null"
          ]
        },
        "pid": {
          "type": "integer",
          "minimum": 0
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "since": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "user",
        "host",
        "pid",
        "command",
        "since"
      ]
    },
    "stage": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "Infrastructure",
            "ResourceSet"
          ]
        },
        "target": {
          "type": "string"
        },
        "host": {
          "type": [
            "string",
            "null"
          ]
        },
        "credential": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "compiled",
            "planned",
            "applied",
            "deferred",
            "skipped",
            "drift",
            "left-out",
            "failed",
            "not-run"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "For a failed stage, its error code from docs/reference/errors.md"
        },
        "artifact": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "hash": {
                  "type": "string"
                },
                "files": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "hash",
                "files"
              ]
            }
          ]
        },
        "writtenTo": {
          "type": "string",
          "description": "compile --out: the directory the files were written to"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "target": {
                "type": "string"
              },
              "resource": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "message": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "target",
              "resource",
              "message"
            ]
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "subject": {
                "type": "string"
              },
              "condition": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "subject",
              "condition"
            ]
          }
        },
        "policy": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "allowed": {
                  "type": "boolean"
                },
                "asked": {
                  "type": "boolean"
                },
                "deny": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "warn": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "allowed",
                "asked",
                "deny",
                "warn"
              ]
            }
          ]
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/change"
          }
        },
        "unknown": {
          "type": "boolean",
          "description": "planned: the tool cannot preview"
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/output"
          }
        },
        "waitingOn": {
          "$ref": "#/$defs/stageId"
        },
        "waitingFor": {
          "type": "string"
        },
        "appliedIn": {
          "type": "string"
        },
        "drift": {
          "type": "string",
          "enum": [
            "never-applied",
            "in-sync",
            "drifted",
            "pending",
            "unknown"
          ]
        },
        "lastApplyFailed": {
          "type": "boolean"
        },
        "condition": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "becauseOf": {
          "$ref": "#/$defs/stageId"
        },
        "previousGood": {
          "type": [
            "string",
            "null"
          ]
        },
        "analyses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "analyzer": {
                "type": "string"
              },
              "asked": {
                "type": "boolean"
              },
              "error": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "counts": {
                "type": "object",
                "properties": {
                  "critical": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "high": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "medium": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "low": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "info": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "accepted": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false,
                "required": [
                  "critical",
                  "high",
                  "medium",
                  "low",
                  "info",
                  "accepted"
                ]
              },
              "findings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "rule": {
                      "type": "string"
                    },
                    "severity": {
                      "type": "string",
                      "enum": [
                        "critical",
                        "high",
                        "medium",
                        "low",
                        "info"
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "file": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "line": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1
                    },
                    "resource": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "document": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "documentLine": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1
                    },
                    "url": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "accepted": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "rule",
                    "severity",
                    "message",
                    "file",
                    "line",
                    "resource",
                    "document",
                    "documentLine",
                    "url",
                    "accepted"
                  ]
                }
              },
              "measures": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "value": {
                      "type": "number"
                    },
                    "unit": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "value",
                    "unit"
                  ]
                }
              }
            },
            "additionalProperties": false,
            "required": [
              "analyzer",
              "asked",
              "error",
              "counts",
              "findings",
              "measures"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "target",
        "host",
        "credential",
        "status",
        "reason",
        "artifact",
        "warnings",
        "removed",
        "policy",
        "analyses",
        "previousGood"
      ]
    },
    "rollback": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "Infrastructure",
            "ResourceSet"
          ]
        },
        "target": {
          "type": "string"
        },
        "host": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "rolled-back",
            "unchanged",
            "unavailable",
            "failed",
            "not-attempted"
          ]
        },
        "to": {
          "type": "string"
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/change"
          }
        },
        "error": {
          "type": "string"
        },
        "becauseOf": {
          "$ref": "#/$defs/stageId"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "target",
        "host",
        "status"
      ]
    }
  }
}
