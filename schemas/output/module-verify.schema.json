{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ZanattaMichael/meridian-core/schemas/output/module-verify.schema.json",
  "title": "module verify",
  "description": "Each pinned module checked against the lock, and its signature.",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "const": "module verify",
      "description": "The subcommand as it is typed"
    },
    "ok": {
      "type": "boolean",
      "description": "Whether the command did what was asked: false means it exited 1, or 130 when interrupted"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": "string"
          },
          "resolved": {
            "type": [
              "string",
              "null"
            ]
          },
          "integrity": {
            "type": [
              "string",
              "null"
            ]
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ok": {
            "type": "boolean"
          },
          "problem": {
            "type": [
              "string",
              "null"
            ]
          },
          "signature": {
            "$ref": "#/$defs/signature"
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "source",
          "resolved",
          "integrity",
          "requires",
          "ok",
          "problem",
          "signature"
        ]
      }
    }
  },
  "required": [
    "command",
    "ok",
    "modules"
  ],
  "additionalProperties": false,
  "$defs": {
    "signature": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "not-checked",
            "verified",
            "unsigned",
            "invalid"
          ]
        },
        "keyId": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "state"
      ]
    }
  }
}
