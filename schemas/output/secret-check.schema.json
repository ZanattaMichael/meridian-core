{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ZanattaMichael/meridian-core/schemas/output/secret-check.schema.json",
  "title": "secret check",
  "description": "Where each declared secret comes from and whether it would be found.",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "const": "secret check",
      "description": "The subcommand as it is typed"
    },
    "ok": {
      "type": "boolean",
      "description": "Whether the command did what was asked: false means it exited 1, or 130 when interrupted"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "secrets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "from": {
                  "type": "string"
                },
                "optional": {
                  "type": "boolean"
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "ok",
                    "not-checked",
                    "absent-optional",
                    "missing",
                    "refused",
                    "unavailable"
                  ]
                },
                "answered": {
                  "type": "boolean"
                },
                "detail": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "name",
                "from",
                "optional",
                "state",
                "answered",
                "detail"
              ]
            }
          },
          "credentials": {
            "type": "array",
            "description": "The credentials declared from: ambient, and whether each would be found here",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "ok",
                    "not-checked",
                    "missing",
                    "refused",
                    "unavailable"
                  ]
                },
                "answered": {
                  "type": "boolean"
                },
                "detail": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "name",
                "type",
                "state",
                "answered",
                "detail"
              ]
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "file",
          "secrets",
          "credentials"
        ]
      }
    },
    "declared": {
      "type": "integer",
      "minimum": 0
    },
    "unanswered": {
      "type": "integer",
      "minimum": 0
    },
    "credentialsDeclared": {
      "type": "integer",
      "minimum": 0
    },
    "credentialsUnanswered": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "command",
    "ok",
    "documents",
    "declared",
    "unanswered",
    "credentialsDeclared",
    "credentialsUnanswered"
  ],
  "additionalProperties": false
}
