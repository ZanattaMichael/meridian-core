{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ZanattaMichael/meridian-core/schemas/output/logs.schema.json",
  "title": "logs",
  "description": "The tool output a run kept on this machine, step by step, after the filters.",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "const": "logs",
      "description": "The subcommand as it is typed"
    },
    "ok": {
      "type": "boolean",
      "description": "Whether the command did what was asked: false means it exited 1, or 130 when interrupted"
    },
    "run": {
      "type": "string",
      "description": "The run's id"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "Infrastructure",
              "ResourceSet"
            ]
          },
          "target": {
            "type": "string"
          },
          "endpoint": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "succeeded",
              "failed",
              "skipped",
              "deferred",
              "not-run",
              "rolled-back"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "file": {
            "type": [
              "string",
              "null"
            ],
            "description": "The log file; null when this machine kept none for the step"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "time": {
                  "type": "string"
                },
                "stream": {
                  "type": "string",
                  "description": "stdout or stderr for the tool's lines, meridian for what Meridian added; empty for a line of another shape"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "time",
                "stream",
                "text"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "kind",
          "target",
          "endpoint",
          "status",
          "reason",
          "file",
          "lines"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "command",
    "ok",
    "run",
    "steps"
  ],
  "additionalProperties": false
}
