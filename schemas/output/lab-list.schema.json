{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ZanattaMichael/meridian-core/schemas/output/lab-list.schema.json",
  "title": "lab list",
  "description": "Every cell of the lab and how it ended in the last run.",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "const": "lab list",
      "description": "The subcommand as it is typed"
    },
    "ok": {
      "type": "boolean",
      "description": "Whether the command did what was asked: false means it exited 1, or 130 when interrupted"
    },
    "lab": {
      "type": "string"
    },
    "lastRun": {
      "type": [
        "string",
        "null"
      ],
      "description": "The last run's id, or null when the lab never ran"
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cell": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "values": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "The cell's value for each matrix axis"
          },
          "last": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "error",
              "not-run"
            ],
            "description": "How the cell ended in the last run; not-run when it was not part of it"
          }
        },
        "additionalProperties": false,
        "required": [
          "cell",
          "name",
          "values",
          "last"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "command",
    "ok",
    "lab",
    "lastRun",
    "cells"
  ]
}
