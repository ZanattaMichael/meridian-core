{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ZanattaMichael/meridian-core/schemas/output/signing-sign.schema.json",
  "title": "signing sign",
  "description": "The signatures written.",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "const": "signing sign",
      "description": "The subcommand as it is typed"
    },
    "ok": {
      "type": "boolean",
      "description": "Whether the command did what was asked: false means it exited 1, or 130 when interrupted"
    },
    "keyId": {
      "type": "string"
    },
    "signed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "binary": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "binary",
          "signature"
        ]
      }
    }
  },
  "required": [
    "command",
    "ok",
    "keyId",
    "signed"
  ],
  "additionalProperties": false
}
