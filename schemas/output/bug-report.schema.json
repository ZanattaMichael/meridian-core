{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ZanattaMichael/meridian-core/schemas/output/bug-report.schema.json",
  "title": "bug-report",
  "description": "The archive that was written, and what is in it.",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "const": "bug-report",
      "description": "The subcommand as it is typed"
    },
    "ok": {
      "type": "boolean",
      "description": "Whether the command did what was asked: false means it exited 1, or 130 when interrupted"
    },
    "run": {
      "type": "string",
      "description": "The run's id"
    },
    "out": {
      "type": "string",
      "description": "The archive written"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The files in it, relative to its one directory, meridian-bug-report-<run>/"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "The archive's size"
    }
  },
  "required": [
    "command",
    "ok",
    "run",
    "out",
    "files",
    "bytes"
  ],
  "additionalProperties": false
}
