{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ZanattaMichael/meridian-core/schemas/output/rules-check.schema.json",
  "title": "rules check",
  "description": "The layers, the rules file, and every violation.",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "const": "rules check",
      "description": "The subcommand as it is typed"
    },
    "ok": {
      "type": "boolean",
      "description": "Whether the command did what was asked: false means it exited 1, or 130 when interrupted"
    },
    "rulesFile": {
      "type": [
        "string",
        "null"
      ]
    },
    "rules": {
      "type": [
        "integer",
        "null"
      ]
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "group": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "path",
          "group"
        ]
      }
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule": {
            "type": "string"
          },
          "check": {
            "type": "string"
          },
          "layer": {
            "type": [
              "string",
              "null"
            ]
          },
          "group": {
            "type": [
              "string",
              "null"
            ]
          },
          "key": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "rule",
          "check",
          "layer",
          "group",
          "key",
          "message"
        ]
      }
    }
  },
  "required": [
    "command",
    "ok",
    "rulesFile",
    "rules",
    "layers",
    "violations"
  ],
  "additionalProperties": false
}
