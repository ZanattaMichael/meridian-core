{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ZanattaMichael/meridian-core/schemas/output/module-list.schema.json",
  "title": "module list",
  "description": "The pinned modules.",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "const": "module list",
      "description": "The subcommand as it is typed"
    },
    "ok": {
      "type": "boolean",
      "description": "Whether the command did what was asked: false means it exited 1, or 130 when interrupted"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": "string"
          },
          "resolved": {
            "type": [
              "string",
              "null"
            ]
          },
          "integrity": {
            "type": [
              "string",
              "null"
            ]
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "source",
          "resolved",
          "integrity",
          "requires"
        ]
      }
    }
  },
  "required": [
    "command",
    "ok",
    "modules"
  ],
  "additionalProperties": false
}
