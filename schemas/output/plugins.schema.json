{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ZanattaMichael/meridian-core/schemas/output/plugins.schema.json",
  "title": "plugins",
  "description": "The plugin catalogue, with each plugin's settings.",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "const": "plugins",
      "description": "The subcommand as it is typed"
    },
    "ok": {
      "type": "boolean",
      "description": "Whether the command did what was asked: false means it exited 1, or 130 when interrupted"
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "can": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "compile",
                "plan",
                "apply",
                "outputs",
                "inputs",
                "import",
                "schemas"
              ]
            }
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "versions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "imports": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "patterns": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "name",
                "description",
                "patterns"
              ]
            }
          },
          "sdk": {
            "type": "string"
          },
          "protocol": {
            "type": "integer",
            "minimum": 0
          },
          "binary": {
            "type": [
              "string",
              "null"
            ]
          },
          "signature": {
            "$ref": "#/$defs/signature"
          },
          "settings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "variable": {
                  "type": "string"
                },
                "default": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "description": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "name",
                "variable",
                "default",
                "description"
              ]
            }
          },
          "rules": {
            "type": "array",
            "description": "The refusal rules the plugin has of its own, beside the general ones every target shares",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "meaning": {
                  "type": "string"
                },
                "hint": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false,
              "required": [
                "name",
                "meaning",
                "hint"
              ]
            }
          },
          "debugLevels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "What --tool-debug 1, 2 and 3 do to the tool, in order; fewer when the target has fewer, none when it has no debug output"
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "category",
          "can",
          "resources",
          "versions",
          "imports",
          "sdk",
          "protocol",
          "binary",
          "signature",
          "settings",
          "rules",
          "debugLevels"
        ]
      }
    }
  },
  "required": [
    "command",
    "ok",
    "plugins"
  ],
  "additionalProperties": false,
  "$defs": {
    "signature": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "not-checked",
            "verified",
            "unsigned",
            "invalid"
          ]
        },
        "keyId": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "state"
      ]
    }
  }
}
