{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ZanattaMichael/meridian-core/schemas/output/retarget.schema.json",
  "title": "retarget",
  "description": "The file written, the target it moves to, and per document what was adopted.",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "const": "retarget",
      "description": "The subcommand as it is typed"
    },
    "ok": {
      "type": "boolean",
      "description": "Whether the command did what was asked: false means it exited 1, or 130 when interrupted"
    },
    "file": {
      "type": "string",
      "description": "The file read, unchanged"
    },
    "out": {
      "type": "string",
      "description": "The file written"
    },
    "outFrom": {
      "type": "string",
      "enum": [
        "cli",
        "manifest",
        "default"
      ],
      "description": "What chose `out`: --out, spec.retarget.out in meridian.yaml, or the default {name}.{target}.{ext}"
    },
    "to": {
      "type": "string"
    },
    "adoption": {
      "type": "string",
      "enum": [
        "none",
        "import",
        "converge"
      ],
      "description": "How the new target takes what exists"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "from": {
            "type": "string",
            "description": "The target the document was on"
          },
          "adopted": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The resources given an `adopt:` line"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "What the author has to check by hand"
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "from",
          "adopted",
          "notes"
        ]
      }
    },
    "warning": {
      "type": [
        "string",
        "null"
      ],
      "description": "Set when the new target will create every resource again"
    }
  },
  "required": [
    "command",
    "ok",
    "file",
    "out",
    "outFrom",
    "to",
    "adoption",
    "documents",
    "warning"
  ],
  "additionalProperties": false
}
