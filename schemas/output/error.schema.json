{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ZanattaMichael/meridian-core/schemas/output/error.schema.json",
  "title": "An error",
  "description": "What any command prints when it failed before it had a result.",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "description": "The subcommand as it is typed"
    },
    "ok": {
      "type": "boolean",
      "const": false,
      "description": "Whether the command did what was asked: false means it exited 1, or 130 when interrupted"
    },
    "error": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "message"
      ]
    }
  },
  "required": [
    "command",
    "ok",
    "error"
  ],
  "additionalProperties": false
}
