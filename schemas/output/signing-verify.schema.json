{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ZanattaMichael/meridian-core/schemas/output/signing-verify.schema.json",
  "title": "signing verify",
  "description": "What each binary's signature amounts to.",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "const": "signing verify",
      "description": "The subcommand as it is typed"
    },
    "ok": {
      "type": "boolean",
      "description": "Whether the command did what was asked: false means it exited 1, or 130 when interrupted"
    },
    "binaries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "binary": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          },
          "signature": {
            "$ref": "#/$defs/signature"
          }
        },
        "additionalProperties": false,
        "required": [
          "binary",
          "verified",
          "signature"
        ]
      }
    }
  },
  "required": [
    "command",
    "ok",
    "binaries"
  ],
  "additionalProperties": false,
  "$defs": {
    "signature": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "not-checked",
            "verified",
            "unsigned",
            "invalid"
          ]
        },
        "keyId": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "state"
      ]
    }
  }
}
