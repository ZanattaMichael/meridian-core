{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ZanattaMichael/meridian-core/schemas/output/unlock.schema.json",
  "title": "unlock",
  "description": "The lock that was removed.",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "const": "unlock",
      "description": "The subcommand as it is typed"
    },
    "ok": {
      "type": "boolean",
      "description": "Whether the command did what was asked: false means it exited 1, or 130 when interrupted"
    },
    "removed": {
      "$ref": "#/$defs/lock"
    }
  },
  "required": [
    "command",
    "ok",
    "removed"
  ],
  "additionalProperties": false,
  "$defs": {
    "lock": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "user": {
          "type": [
            "string",
            "null"
          ]
        },
        "host": {
          "type": [
            "string",
            "null"
          ]
        },
        "pid": {
          "type": "integer",
          "minimum": 0
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "since": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "user",
        "host",
        "pid",
        "command",
        "since"
      ]
    }
  }
}
