{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ZanattaMichael/meridian-core/schemas/output/diagnose.schema.json",
  "title": "diagnose",
  "description": "What broke in a run, on which machine, and what to run next.",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "const": "diagnose",
      "description": "The subcommand as it is typed"
    },
    "ok": {
      "type": "boolean",
      "description": "Whether the command did what was asked: false means it exited 1"
    },
    "run": {
      "oneOf": [
        {
          "type": "null",
          "description": "No failed run is recorded"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "mode": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "running",
                "succeeded",
                "failed"
              ]
            },
            "resumes": {
              "type": [
                "string",
                "null"
              ]
            },
            "steps": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "id",
            "mode",
            "status",
            "resumes",
            "steps"
          ],
          "additionalProperties": false
        }
      ]
    },
    "failed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "Infrastructure",
              "ResourceSet"
            ]
          },
          "target": {
            "type": "string"
          },
          "endpoint": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "cause": {
                  "type": "string",
                  "description": "The cause word, or the step's reason when the tool named no resource"
                },
                "endpoints": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "The machines; more than one when they failed the same way"
                },
                "failures": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "endpoint": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "resource": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "cause": {
                        "type": "string"
                      },
                      "toolCode": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "summary": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Null when this machine did not keep the run's failures"
                      },
                      "at": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Where the resource is declared, as site.yaml:42"
                      }
                    },
                    "required": [
                      "endpoint",
                      "resource",
                      "cause",
                      "toolCode",
                      "summary",
                      "at"
                    ],
                    "additionalProperties": false
                  },
                  "description": "Of the first machine when grouped"
                },
                "next": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "What to run or check next, in order"
                }
              },
              "required": [
                "cause",
                "endpoints",
                "failures",
                "next"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "kind",
          "target",
          "endpoint",
          "reason",
          "entries"
        ],
        "additionalProperties": false
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "Infrastructure",
              "ResourceSet"
            ]
          },
          "becauseOf": {
            "type": [
              "string",
              "null"
            ],
            "description": "The step that failed first; null when the events are gone"
          }
        },
        "required": [
          "name",
          "kind",
          "becauseOf"
        ],
        "additionalProperties": false
      }
    },
    "keptHere": {
      "type": "boolean",
      "description": "Whether the tools' words come from this machine's failures.jsonl"
    }
  },
  "required": [
    "command",
    "ok",
    "run",
    "failed"
  ],
  "additionalProperties": false
}
