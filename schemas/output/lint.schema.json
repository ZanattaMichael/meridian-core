{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ZanattaMichael/meridian-core/schemas/output/lint.schema.json",
  "title": "lint",
  "description": "Every finding, and the counts.",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "const": "lint",
      "description": "The subcommand as it is typed"
    },
    "ok": {
      "type": "boolean",
      "description": "Whether the command did what was asked: false means it exited 1, or 130 when interrupted"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 0
          },
          "column": {
            "type": "integer",
            "minimum": 0
          },
          "endLine": {
            "type": "integer",
            "minimum": 0
          },
          "endColumn": {
            "type": "integer",
            "minimum": 0
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "info"
            ]
          },
          "code": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "fixable": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": [
          "file",
          "line",
          "column",
          "endLine",
          "endColumn",
          "severity",
          "code",
          "source",
          "message",
          "fixable"
        ]
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": "integer",
          "minimum": 0
        },
        "fixed": {
          "type": "integer",
          "minimum": 0
        },
        "documents": {
          "type": "integer",
          "minimum": 0
        },
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "pluginsFound": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "errors",
        "warnings",
        "notes",
        "fixed",
        "documents",
        "files",
        "pluginsFound"
      ]
    }
  },
  "required": [
    "command",
    "ok",
    "diagnostics",
    "summary"
  ],
  "additionalProperties": false
}
