{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ZanattaMichael/meridian-core/schemas/output/secret-set.schema.json",
  "title": "secret set",
  "description": "Where the value was stored.",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "const": "secret set",
      "description": "The subcommand as it is typed"
    },
    "ok": {
      "type": "boolean",
      "description": "Whether the command did what was asked: false means it exited 1, or 130 when interrupted"
    },
    "name": {
      "type": "string"
    },
    "from": {
      "type": "string"
    },
    "storedIn": {
      "type": "string"
    }
  },
  "required": [
    "command",
    "ok",
    "name",
    "from",
    "storedIn"
  ],
  "additionalProperties": false
}
