{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ZanattaMichael/meridian-core/schemas/output/validate.schema.json",
  "title": "validate",
  "description": "Whether the documents read and validate, and every problem found. Any command that reads documents prints this when they do not validate.",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "description": "The subcommand as it is typed"
    },
    "ok": {
      "type": "boolean",
      "description": "Whether the command did what was asked: false means it exited 1, or 130 when interrupted"
    },
    "documents": {
      "type": "integer",
      "minimum": 0
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 0,
            "description": "1-based; 0 when the problem is the whole file"
          },
          "column": {
            "type": "integer",
            "minimum": 0
          },
          "path": {
            "type": "string",
            "description": "The field, such as spec.resources[0].type; empty for the whole document"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "file",
          "line",
          "column",
          "path",
          "message"
        ]
      }
    }
  },
  "required": [
    "command",
    "ok",
    "documents",
    "diagnostics"
  ],
  "additionalProperties": false
}
