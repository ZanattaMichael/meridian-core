AWSTemplateFormatVersion: "2010-09-09"
Description: Compiled by Meridian from the document web-cloudformation. Do not edit.
Resources:
  Net:
    Type: AWS::EC2::VPC
    Properties:
      CidrBlock: 10.0.0.0/16
      EnableDnsHostnames: true
      EnableDnsSupport: true
      Tags:
        - Key: Name
          Value: net
  NetGateway:
    Type: AWS::EC2::InternetGateway
    Properties:
      Tags:
        - Key: Name
          Value: net
  NetGatewayLink:
    Type: AWS::EC2::VPCGatewayAttachment
    Properties:
      InternetGatewayId:
        Ref: NetGateway
      VpcId:
        Ref: Net
  Web:
    Type: AWS::EC2::Subnet
    Properties:
      CidrBlock: 10.0.1.0/24
      MapPublicIpOnLaunch: true
      Tags:
        - Key: Name
          Value: web
      VpcId:
        Ref: Net
  WebRoutes:
    Type: AWS::EC2::RouteTable
    Properties:
      Tags:
        - Key: Name
          Value: web
      VpcId:
        Ref: Net
  WebRoutesInternet:
    Type: AWS::EC2::Route
    DependsOn:
      - NetGatewayLink
    Properties:
      DestinationCidrBlock: 0.0.0.0/0
      GatewayId:
        Ref: NetGateway
      RouteTableId:
        Ref: WebRoutes
  WebRoutesLink:
    Type: AWS::EC2::SubnetRouteTableAssociation
    Properties:
      RouteTableId:
        Ref: WebRoutes
      SubnetId:
        Ref: Web
  WebFw:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: web_fw
      GroupName: web_fw
      SecurityGroupIngress:
        - CidrIp: 203.0.113.0/24
          FromPort: 22
          IpProtocol: tcp
          ToPort: 22
        - CidrIp: 0.0.0.0/0
          FromPort: 80
          IpProtocol: tcp
          ToPort: 80
        - CidrIp: 0.0.0.0/0
          FromPort: 443
          IpProtocol: tcp
          ToPort: 443
      Tags:
        - Key: Name
          Value: web_fw
      VpcId:
        Ref: Net
  WebIp:
    Type: AWS::EC2::EIP
    Properties:
      Domain: vpc
      Tags:
        - Key: Name
          Value: web_ip
  VmKey:
    Type: AWS::EC2::KeyPair
    Properties:
      KeyName: vm
      PublicKeyMaterial: ssh-rsa  admin@example.com
  Vm:
    Type: AWS::EC2::Instance
    Properties:
      ImageId: '{{resolve:ssm:/aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id}}'
      InstanceType: t3.medium
      KeyName:
        Ref: VmKey
      SecurityGroupIds:
        - Fn::GetAtt:
            - WebFw
            - GroupId
      SubnetId:
        Ref: Web
      Tags:
        - Key: Name
          Value: vm
  VmAddress:
    Type: AWS::EC2::EIPAssociation
    Properties:
      AllocationId:
        Fn::GetAtt:
          - WebIp
          - AllocationId
      InstanceId:
        Ref: Vm
  Store:
    Type: AWS::EC2::Volume
    Properties:
      AvailabilityZone:
        Fn::GetAtt:
          - Vm
          - AvailabilityZone
      Size: 50
      Tags:
        - Key: Name
          Value: store
      VolumeType: gp3
  StoreAttachment:
    Type: AWS::EC2::VolumeAttachment
    Properties:
      Device: /dev/sdf
      InstanceId:
        Ref: Vm
      VolumeId:
        Ref: Store
  Files:
    Type: AWS::S3::Bucket
    Properties:
      BucketName: files
      Tags:
        - Key: Name
          Value: files
      VersioningConfiguration:
        Status: Enabled
  Www:
    Type: AWS::Route53::RecordSet
    Properties:
      HostedZoneName: example.com.
      Name: www.example.com.
      ResourceRecords:
        - Fn::GetAtt:
            - WebIp
            - PublicIp
      TTL: "300"
      Type: A
  Logs:
    Type: AWS::S3::Bucket
Outputs:
  Address:
    Value:
      Fn::GetAtt:
        - WebIp
        - PublicIp
  PrivateAddress:
    Value:
      Fn::GetAtt:
        - Vm
        - PrivateIp
