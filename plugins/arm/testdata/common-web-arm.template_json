{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Compiled by Meridian from the document web-arm. Do not edit."
  },
  "outputs": {
    "address": {
      "type": "string",
      "value": "[string(reference(resourceId('Microsoft.Network/publicIPAddresses', 'web_ip'), '2023-09-01').ipAddress)]"
    },
    "private_address": {
      "type": "string",
      "value": "[string(reference(resourceId('Microsoft.Network/networkInterfaces', 'vm-nic'), '2023-09-01').ipConfigurations[0].properties.privateIPAddress)]"
    }
  },
  "resources": [
    {
      "apiVersion": "2023-09-01",
      "location": "[resourceGroup().location]",
      "name": "net",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "10.0.0.0/16"
          ]
        }
      },
      "type": "Microsoft.Network/virtualNetworks"
    },
    {
      "apiVersion": "2023-09-01",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', 'net')]"
      ],
      "name": "[format('{0}/web', 'net')]",
      "properties": {
        "addressPrefix": "10.0.1.0/24"
      },
      "type": "Microsoft.Network/virtualNetworks/subnets"
    },
    {
      "apiVersion": "2023-09-01",
      "location": "[resourceGroup().location]",
      "name": "web_fw",
      "properties": {
        "securityRules": [
          {
            "name": "rule-0",
            "properties": {
              "access": "Allow",
              "destinationAddressPrefix": "*",
              "destinationPortRange": "22",
              "direction": "Inbound",
              "priority": 100,
              "protocol": "Tcp",
              "sourceAddressPrefix": "203.0.113.0/24",
              "sourcePortRange": "*"
            }
          },
          {
            "name": "rule-1",
            "properties": {
              "access": "Allow",
              "destinationAddressPrefix": "*",
              "destinationPortRange": "80",
              "direction": "Inbound",
              "priority": 101,
              "protocol": "Tcp",
              "sourceAddressPrefix": "0.0.0.0/0",
              "sourcePortRange": "*"
            }
          },
          {
            "name": "rule-2",
            "properties": {
              "access": "Allow",
              "destinationAddressPrefix": "*",
              "destinationPortRange": "443",
              "direction": "Inbound",
              "priority": 102,
              "protocol": "Tcp",
              "sourceAddressPrefix": "0.0.0.0/0",
              "sourcePortRange": "*"
            }
          }
        ]
      },
      "type": "Microsoft.Network/networkSecurityGroups"
    },
    {
      "apiVersion": "2023-09-01",
      "location": "[resourceGroup().location]",
      "name": "web_ip",
      "properties": {
        "publicIPAllocationMethod": "Static"
      },
      "sku": {
        "name": "Standard"
      },
      "type": "Microsoft.Network/publicIPAddresses"
    },
    {
      "apiVersion": "2023-09-01",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks/subnets', split(format('{0}/web', 'net'), '/')[0], split(format('{0}/web', 'net'), '/')[1])]",
        "[resourceId('Microsoft.Network/networkSecurityGroups', 'web_fw')]",
        "[resourceId('Microsoft.Network/publicIPAddresses', 'web_ip')]"
      ],
      "location": "[resourceGroup().location]",
      "name": "vm-nic",
      "properties": {
        "ipConfigurations": [
          {
            "name": "primary",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', 'web_ip')]"
              },
              "subnet": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', split(format('{0}/web', 'net'), '/')[0], split(format('{0}/web', 'net'), '/')[1])]"
              }
            }
          }
        ],
        "networkSecurityGroup": {
          "id": "[resourceId('Microsoft.Network/networkSecurityGroups', 'web_fw')]"
        }
      },
      "type": "Microsoft.Network/networkInterfaces"
    },
    {
      "apiVersion": "2024-03-01",
      "dependsOn": [
        "[resourceId('Microsoft.Compute/disks', 'store')]",
        "[resourceId('Microsoft.Network/networkInterfaces', 'vm-nic')]"
      ],
      "location": "[resourceGroup().location]",
      "name": "vm",
      "properties": {
        "hardwareProfile": {
          "vmSize": "Standard_B2s"
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', 'vm-nic')]"
            }
          ]
        },
        "osProfile": {
          "adminUsername": "azureuser",
          "computerName": "vm",
          "linuxConfiguration": {
            "disablePasswordAuthentication": true,
            "ssh": {
              "publicKeys": [
                {
                  "keyData": "ssh-rsa  admin@example.com",
                  "path": "/home/azureuser/.ssh/authorized_keys"
                }
              ]
            }
          }
        },
        "storageProfile": {
          "dataDisks": [
            {
              "createOption": "Attach",
              "lun": 0,
              "managedDisk": {
                "id": "[resourceId('Microsoft.Compute/disks', 'store')]"
              }
            }
          ],
          "imageReference": {
            "offer": "ubuntu-24_04-lts",
            "publisher": "Canonical",
            "sku": "server",
            "version": "latest"
          },
          "osDisk": {
            "createOption": "FromImage"
          }
        }
      },
      "type": "Microsoft.Compute/virtualMachines"
    },
    {
      "apiVersion": "2024-03-01",
      "location": "[resourceGroup().location]",
      "name": "store",
      "properties": {
        "creationData": {
          "createOption": "Empty"
        },
        "diskSizeGB": 50
      },
      "sku": {
        "name": "StandardSSD_LRS"
      },
      "type": "Microsoft.Compute/disks"
    }
  ]
}
