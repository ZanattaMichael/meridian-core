name: web-pulumi-azure
runtime: yaml
description: Compiled by Meridian from the document web-pulumi-azure. Do not edit.
config:
  azure-native:location:
    value: westeurope
resources:
  net:
    type: azure-native:network:VirtualNetwork
    properties:
      addressSpace:
        addressPrefixes:
          - 10.0.0.0/16
      location: westeurope
      resourceGroupName: web-prod
      virtualNetworkName: net
  web:
    type: azure-native:network:Subnet
    properties:
      addressPrefix: 10.0.1.0/24
      resourceGroupName: web-prod
      subnetName: web
      virtualNetworkName: ${net.name}
  web_fw:
    type: azure-native:network:NetworkSecurityGroup
    properties:
      location: westeurope
      networkSecurityGroupName: web_fw
      resourceGroupName: web-prod
      securityRules:
        - access: Allow
          destinationAddressPrefix: '*'
          destinationPortRange: "22"
          direction: Inbound
          name: rule-0
          priority: 100
          protocol: Tcp
          sourceAddressPrefix: 203.0.113.0/24
          sourcePortRange: '*'
        - access: Allow
          destinationAddressPrefix: '*'
          destinationPortRange: "80"
          direction: Inbound
          name: rule-1
          priority: 101
          protocol: Tcp
          sourceAddressPrefix: 0.0.0.0/0
          sourcePortRange: '*'
        - access: Allow
          destinationAddressPrefix: '*'
          destinationPortRange: "443"
          direction: Inbound
          name: rule-2
          priority: 102
          protocol: Tcp
          sourceAddressPrefix: 0.0.0.0/0
          sourcePortRange: '*'
  web_ip:
    type: azure-native:network:PublicIPAddress
    properties:
      location: westeurope
      publicIPAllocationMethod: Static
      publicIpAddressName: web_ip
      resourceGroupName: web-prod
      sku:
        name: Standard
  vm_nic:
    type: azure-native:network:NetworkInterface
    properties:
      ipConfigurations:
        - name: primary
          privateIPAllocationMethod: Dynamic
          publicIPAddress:
            id: ${web_ip.id}
          subnet:
            id: ${web.id}
      location: westeurope
      networkInterfaceName: vm-nic
      networkSecurityGroup:
        id: ${web_fw.id}
      resourceGroupName: web-prod
  vm:
    type: azure-native:compute:VirtualMachine
    properties:
      hardwareProfile:
        vmSize: Standard_B2s
      location: westeurope
      networkProfile:
        networkInterfaces:
          - id: ${vm_nic.id}
      osProfile:
        adminUsername: azureuser
        computerName: vm
        linuxConfiguration:
          disablePasswordAuthentication: true
          ssh:
            publicKeys:
              - keyData: ssh-rsa  admin@example.com
                path: /home/azureuser/.ssh/authorized_keys
      resourceGroupName: web-prod
      storageProfile:
        dataDisks:
          - createOption: Attach
            lun: 0
            managedDisk:
              id: ${store.id}
        imageReference:
          offer: ubuntu-24_04-lts
          publisher: Canonical
          sku: server
          version: latest
        osDisk:
          createOption: FromImage
      vmName: vm
  store:
    type: azure-native:compute:Disk
    properties:
      creationData:
        createOption: Empty
      diskName: store
      diskSizeGB: 50
      location: westeurope
      resourceGroupName: web-prod
      sku:
        name: StandardSSD_LRS
outputs:
  address: ${web_ip.ipAddress}
  private_address: ${vm_nic.ipConfigurations[0].privateIPAddress}
