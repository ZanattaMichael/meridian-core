name: web-pulumi-aws
runtime: yaml
description: Compiled by Meridian from the document web-pulumi-aws. Do not edit.
config:
  aws:region:
    value: eu-west-1
variables:
  vm_image:
    fn::invoke:
      function: aws:ec2:getAmi
      arguments:
        filters:
          - name: name
            values:
              - ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24.04-amd64-server-*
          - name: architecture
            values:
              - x86_64
        mostRecent: true
        owners:
          - "099720109477"
  www_zone:
    fn::invoke:
      function: aws:route53:getZone
      arguments:
        name: example.com
resources:
  net:
    type: aws:ec2:Vpc
    properties:
      cidrBlock: 10.0.0.0/16
      enableDnsHostnames: true
      tags:
        Name: net
  net_gateway:
    type: aws:ec2:InternetGateway
    properties:
      vpcId: ${net.id}
  web:
    type: aws:ec2:Subnet
    properties:
      cidrBlock: 10.0.1.0/24
      mapPublicIpOnLaunch: true
      tags:
        Name: web
      vpcId: ${net.id}
  web_routes:
    type: aws:ec2:RouteTable
    properties:
      tags:
        Name: web
      vpcId: ${net.id}
  web_routes_internet:
    type: aws:ec2:Route
    properties:
      destinationCidrBlock: 0.0.0.0/0
      gatewayId: ${net_gateway.id}
      routeTableId: ${web_routes.id}
  web_routes_link:
    type: aws:ec2:RouteTableAssociation
    properties:
      routeTableId: ${web_routes.id}
      subnetId: ${web.id}
  web_fw:
    type: aws:ec2:SecurityGroup
    properties:
      name: web_fw
      tags:
        Name: web_fw
      vpcId: ${net.id}
  web_fw_in_0:
    type: aws:vpc:SecurityGroupIngressRule
    properties:
      cidrIpv4: 203.0.113.0/24
      fromPort: 22
      ipProtocol: tcp
      securityGroupId: ${web_fw.id}
      toPort: 22
  web_fw_in_1:
    type: aws:vpc:SecurityGroupIngressRule
    properties:
      cidrIpv4: 0.0.0.0/0
      fromPort: 80
      ipProtocol: tcp
      securityGroupId: ${web_fw.id}
      toPort: 80
  web_fw_in_2:
    type: aws:vpc:SecurityGroupIngressRule
    properties:
      cidrIpv4: 0.0.0.0/0
      fromPort: 443
      ipProtocol: tcp
      securityGroupId: ${web_fw.id}
      toPort: 443
  web_fw_out_all:
    type: aws:vpc:SecurityGroupEgressRule
    properties:
      cidrIpv4: 0.0.0.0/0
      ipProtocol: "-1"
      securityGroupId: ${web_fw.id}
  web_ip:
    type: aws:ec2:Eip
    properties:
      domain: vpc
      tags:
        Name: web_ip
  vm_key:
    type: aws:ec2:KeyPair
    properties:
      keyName: vm
      publicKey: ssh-rsa  admin@example.com
  vm:
    type: aws:ec2:Instance
    properties:
      ami: ${vm_image.id}
      instanceType: t3.medium
      keyName: ${vm_key.keyName}
      subnetId: ${web.id}
      tags:
        Name: vm
      vpcSecurityGroupIds:
        - ${web_fw.id}
  vm_address:
    type: aws:ec2:EipAssociation
    properties:
      allocationId: ${web_ip.id}
      instanceId: ${vm.id}
  store:
    type: aws:ebs:Volume
    properties:
      availabilityZone: ${vm.availabilityZone}
      size: 50
      tags:
        Name: store
      type: gp3
  store_attachment:
    type: aws:ec2:VolumeAttachment
    properties:
      deviceName: /dev/sdf
      instanceId: ${vm.id}
      volumeId: ${store.id}
  files:
    type: aws:s3:BucketV2
    properties:
      bucket: files
      tags:
        Name: files
  files_versioning:
    type: aws:s3:BucketVersioningV2
    properties:
      bucket: ${files.id}
      versioningConfiguration:
        status: Enabled
  www:
    type: aws:route53:Record
    properties:
      name: www.example.com
      records:
        - ${web_ip.publicIp}
      ttl: 300
      type: A
      zoneId: ${www_zone.zoneId}
  logs:
    type: aws:s3:BucketV2
    properties:
      bucketPrefix: web-logs-
outputs:
  address: ${web_ip.publicIp}
  private_address: ${vm.privateIp}
