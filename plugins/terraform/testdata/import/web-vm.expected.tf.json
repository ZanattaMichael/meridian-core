{
  "//": "What testdata/import/web-vm means, written by hand in Terraform's JSON syntax. The round-trip test compares what the imported document compiles to with this.",
  "terraform": {
    "required_providers": {
      "aws": {"source": "hashicorp/aws", "version": "~> 5.0"},
      "random": {"source": "hashicorp/random"}
    },
    "backend": {
      "s3": {"bucket": "example-tfstate", "key": "web/terraform.tfstate", "region": "us-east-1"}
    }
  },
  "provider": {
    "aws": [
      {"region": "${var.region}", "default_tags": {"tags": "${local.tags}"}},
      {"alias": "dns", "region": "us-east-1"}
    ],
    "random": {}
  },
  "variable": {
    "region": {"type": "string", "description": "Where the web server runs.", "default": "eu-west-1"},
    "instance_count": {
      "type": "number",
      "default": 2,
      "validation": {
        "condition": "${var.instance_count > 0}",
        "error_message": "At least one instance is needed."
      }
    },
    "ports": {"type": "list(number)", "default": [80, 443]}
  },
  "locals": {
    "name": "web-${var.region}",
    "tags": {"Name": "${local.name}", "Managed": "terraform"}
  },
  "data": {
    "aws_ami": {
      "ubuntu": {
        "most_recent": true,
        "owners": ["099720109477"],
        "filter": {
          "name": "name",
          "values": ["ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-*"]
        }
      }
    }
  },
  "resource": {
    "random_id": {"suffix": {"byte_length": 4}},
    "aws_security_group": {
      "web": {
        "name": "${local.name}-${random_id.suffix.hex}",
        "dynamic": {
          "ingress": {
            "for_each": "${var.ports}",
            "content": {
              "from_port": "${(ingress.value)}",
              "to_port": "${(ingress.value)}",
              "protocol": "tcp",
              "cidr_blocks": ["0.0.0.0/0"]
            }
          }
        },
        "egress": {"from_port": 0, "to_port": 0, "protocol": "-1", "cidr_blocks": ["0.0.0.0/0"]}
      }
    },
    "aws_instance": {
      "web_aws_instance": {
        "count": "${var.instance_count}",
        "ami": "${data.aws_ami.ubuntu.id}",
        "instance_type": "${var.region == \"us-east-1\" ? \"t3.small\" : \"t3.micro\"}",
        "vpc_security_group_ids": ["${aws_security_group.web.id}"],
        "user_data": "#!/bin/sh\necho \"hello from ${local.name}\" > /etc/motd\n",
        "tags": "${merge(local.tags, { Index = count.index })}",
        "lifecycle": {
          "create_before_destroy": true,
          "ignore_changes": ["ami"],
          "replace_triggered_by": ["aws_security_group.web"]
        }
      }
    },
    "aws_eip": {
      "web_aws_eip": {"instance": "${aws_instance.web_aws_instance[0].id}"}
    }
  },
  "module": {
    "dns": {
      "source": "terraform-aws-modules/route53/aws//modules/records",
      "version": "~> 2.0",
      "providers": {"aws": "aws.dns"},
      "zone_name": "example.com",
      "records": [
        {"name": "www", "type": "A", "ttl": 300, "records": ["${aws_eip.web_aws_eip.public_ip}"]}
      ],
      "depends_on": ["aws_instance.web_aws_instance"]
    }
  },
  "output": {
    "address": {"value": "${aws_eip.web_aws_eip.public_ip}"},
    "url": {"value": "http://${aws_eip.web_aws_eip.public_dns}/"},
    "instance_ids": {"value": "${aws_instance.web_aws_instance[*].id}"}
  }
}
